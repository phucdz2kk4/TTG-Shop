extends ../../layouts/default.pug
include ../../mixins/filter-status.pug
include ../../mixins/search.pug
include ../../mixins/pagination.pug
include ../../mixins/form-change-multi.pug

block main 
    h1.padding List product

    .card.mb3-3.margin2.width3
        .card.sett.padding Search and Filter 
        .card.body
            .btn-group-toggle.no-boder.edit.padding.all(data-toggle='buttons')
                .col6.width1
                    +filter-status(filterStatus)
                .col6.width
                    +search(keyword)

    .card.mb-3.margin2.width3
        h5.card-header List
            .card-body
             +form-change-multi(`${prefixAdmin}/products/change-multi?_method=PATCH`)

    table(
        class="table sett margin2"
        checkbox-multi 
    )
        thead
            tr
                th
                 input(
                    type="checkbox"
                    name="checkall"
                )
                th(scope='col') Number 
                th(scope='col') Image 
                th(scope='col') Title
                th(scope='col') Price
                th(scope='col') Status
                th(scope='col') Action
        tbody
            each item, index in products 
                tr
                    th
                        input(
                            type="checkbox"
                            name="id"
                            value=item.id 
                        )
                    td #{index + 1}
                    td 
                        img(
                            src=item.thumbnail
                            alt=item.title
                            width="100px"
                            height="auto"
                    )
                    td #{item.title}
                    td #{item.priceNew}
                    td 
                        if(item.status == "active")
                            a(
                                href="javascript:;"
                                data-status=item.status 
                                data-id=item.id 
                                button-change-status 
                                class="badge badge-success"
                            ) Active
                        else
                            a(
                                href="javascript:;"
                                data-status=item.status 
                                data-id=item.id 
                                button-change-status 
                                class="badge badge-danger"
                            ) Inactive
                    td 
                        button.btn.btn-primary.btn-sm.set(type='button') Edit
                        button(
                            class="btn btn-danger btn-sm set"
                            button-delete 
                            data-id=item.id
                        ) Delete

    
    +pagination(pagination)

    form(
        action=""
        method="POST"
        id="form-change-status"
        data-path=`${prefixAdmin}/products/change-status`
    )

    form(
        action=""
        method="POST"
        id="form-delete-item"
        data-path=`${prefixAdmin}/products/delete` 
    )

    script(src="/admin/js/product.js")

 

